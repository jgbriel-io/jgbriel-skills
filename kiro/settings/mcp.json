{
  "mcpServers": {
    "context-mode": {
      "command": "context-mode",
      "disabled": true,
      "autoApprove": [
        "ctx_batch_execute"
      ]
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@latest"
      ],
      "disabled": false,
      "autoApprove": [
        "resolve-library-id",
        "get-library-docs"
      ]
    },
    "shadcn": {
      "command": "npx",
      "args": [
        "-y",
        "@jpisnice/shadcn-ui-mcp-server"
      ],
      "disabled": false,
      "autoApprove": [
        "get_component",
        "list_components",
        "get_block",
        "search_components"
      ]
    }
  }
}